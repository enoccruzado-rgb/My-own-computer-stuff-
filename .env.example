# Copy to .env, fill in, then `set -a; source .env; set +a` before starting Claude Code.
# Never commit .env.

# Alpaca (https://app.alpaca.markets -> API keys). Paper trading is free.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true          # set false only when you mean real money

# tastytrade (https://developer.tastytrade.com -> OAuth app)
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_USE_PRODUCTION=false  # false = sandbox

# Crypto exchange via CCXT (coinbase, kraken, binanceus, okx, bybit, ...)
CCXT_MCP_EXCHANGE=coinbase
CCXT_MCP_APIKEY=
CCXT_MCP_SECRET=
CCXT_MCP_SANDBOX=false
CCXT_MCP_TRADING=false           # true lets Claude place orders

# Schwab / thinkorswim (https://developer.schwab.com), used by schwab-py
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
